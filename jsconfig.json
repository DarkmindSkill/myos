{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "checkJs": false
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
